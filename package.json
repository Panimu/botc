{
  "name": "botc-personality",
  "private": true,
  "type": "module",
  "description": "Which Blood on the Clocktower character are you? A binary-elimination personality quiz.",
  "scripts": {
    "serve": "node scripts/build-site.js && python -m http.server 8000 -d _site",
    "validate": "node scripts/validate.js",
